{$SITE_ADDRESS} {
  encode zstd gzip

  @backend path /api/* /actuator/health /actuator/info
  handle @backend {
    reverse_proxy api:8080
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
